# バックエンド(FastAPI)の環境変数
# このファイルをコピーして .env を作成し、値を設定する(.env はコミットしない)
# 読み込む順番:.env → .env.<APP_ENV>(例:.env.test)→ 環境変数(後ろほど優先)

# 実行環境:development / test / production(0-3)
APP_ENV=development
LOG_LEVEL=INFO
# true:1行 1 JSON(本番)/ false:人が読みやすい形(開発)
LOG_JSON=false

# Supabase。ローカル(supabase start)の値は `supabase status` で確認できる
SUPABASE_URL=http://127.0.0.1:54321
# 秘密鍵。ブラウザ側には絶対に渡さないこと
SUPABASE_SECRET_KEY=
# PostgreSQL の接続文字列(ローカル:postgresql://postgres:postgres@127.0.0.1:54322/postgres)
DATABASE_URL=
# 画像用 Storage バケット名(非公開。9章)
MEDIA_BUCKET=media
# 1次の公開バケット(互換のため残している)
SUPABASE_STORAGE_BUCKET=post-images

# DB コネクションプール(22-4)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=5000

# Redis(docker compose up -d redis)
REDIS_URL=redis://localhost:6379/0

# Gemini API(Google AI Studio で発行)
GEMINI_API_KEY=
# 使用するモデル名(要件定義書 4.3。Flash 系に切り替える場合は全体の上限値も下げること)
GEMINI_MODEL=gemini-3.5-flash-lite

# AI チャットのレート制限(要件定義書 4.2)
RATE_LIMIT_PER_USER_PER_MINUTE=10
RATE_LIMIT_PER_USER_PER_DAY=30
RATE_LIMIT_GLOBAL_PER_MINUTE=12
RATE_LIMIT_GLOBAL_PER_DAY=400

# API のレート制限(1分あたり。8-3)
RATE_LIMIT_POSTS_PER_MINUTE=10
RATE_LIMIT_COMMENTS_PER_MINUTE=20
RATE_LIMIT_LIKES_PER_MINUTE=60

# CORS で許可するフロントエンドのオリジン(複数ある場合はカンマ区切り)
CORS_ALLOW_ORIGINS=http://localhost:3000

# メール(11-3)。ローカルは Supabase の Mailpit(受信箱:http://127.0.0.1:54324)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

# Webhook の署名検証の共有鍵(11-6)。未設定なら Webhook は 503
WEBHOOK_SECRET=

# Web Push の秘密鍵(11-7)。未設定ならログに出すだけ
VAPID_PRIVATE_KEY=

# 監視(22章)。未設定なら無効
SENTRY_DSN=
# 本番では必須。Prometheus がこの値を Bearer で送る
METRICS_TOKEN=
# OpenTelemetry を OTLP で送るとき(docker compose --profile monitoring の Jaeger など)
# FASTAPI_OTEL_AUTO_CONFIGURE=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=jelgram-api
